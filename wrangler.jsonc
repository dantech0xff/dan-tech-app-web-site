// Cloudflare Worker that serves the static export in out/ (no Worker script: every request is a static asset).
// Workers Builds runs `npm run build`, then `npx wrangler deploy`, on every push to main.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dantech-app",
  "compatibility_date": "2026-10-20",
  // The Worker answers every request to dantech.app, so the origin behind the zone's A record is never reached.
  // www.dantech.app never gets here: a Cloudflare Redirect Rule sends it to https://dantech.app first.
  "routes": [{ "pattern": "dantech.app/*", "zone_name": "dantech.app" }],
  // The site lives on dantech.app only: no copy on workers.dev, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    // /about/ serves about/index.html; public/_redirects sends /about there with a 301 first.
    "html_handling": "auto-trailing-slash",
    // A miss gets out/404.html with status 404.
    "not_found_handling": "404-page"
  }
}
